# Runtime paths
DATABASE_PATH=/app/runtime/business_analyst.duckdb
ONLINE_RETAIL_PATH=/app/data/online_retail/Online Retail.xlsx

# LLM provider: ollama, groq, openai, or openai_compatible
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=300

# Ollama settings for Docker Compose
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# Hosted/OpenAI-compatible provider settings
# Leave keys blank unless switching away from Ollama.
LLM_MODEL=
LLM_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

